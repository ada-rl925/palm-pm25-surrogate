# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ─── Data (PALM NetCDF too large for git — distributed separately) ───
# Ignore everything under data/ except its README (points users to the download).
data/*
!data/README.md
*.nc

# ─── Model weights: keep every best.pt (all runs), ignore last.pt and other .pt ───
*.pt
!**/best.pt

# ─── Training scratch / logs not meant for publication ───
outputs/_archive/
outputs/**/tb/
*.sh

# ─── Cached OSM geojson (re-downloaded by src/draw_study_area_map.py) ───
outputs/_geo_cache/

# ─── OS ───
.DS_Store
